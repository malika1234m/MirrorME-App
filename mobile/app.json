{
  "expo": {
    "name": "MirrorME",
    "slug": "mirrorme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mirrorme.app",
      "infoPlist": {
        "NSCameraUsageDescription": "MirrorME needs camera access to upload outfit photos and use the Virtual Mirror try-on feature.",
        "NSPhotoLibraryUsageDescription": "MirrorME needs photo library access to upload outfit photos.",
        "NSMicrophoneUsageDescription": "MirrorME needs microphone access for the Virtual Mirror.",
        "WKWebView.mediaType": "camera"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "package": "com.mirrorme.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "MirrorME needs access to your photos to upload outfits.",
          "cameraPermission": "MirrorME needs camera access to take outfit photos."
        }
      ],
      "expo-font"
    ],
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro",
      "output": "static",
      "name": "MirrorME",
      "shortName": "MirrorME",
      "description": "AI Fashion Social — Try on brands, get rated, discover styles"
    },
    "scheme": "mirrorme",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "56e8dcd7-1669-43cd-ac64-5eabb63cf867"
      }
    },
    "owner": "malika_nish"
  }
}
