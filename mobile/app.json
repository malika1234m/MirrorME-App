{
  "expo": {
    "name": "MirrorME",
    "slug": "mirrorme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mirrorme.app",
      "infoPlist": {
        "NSCameraUsageDescription": "MirrorME needs camera access to upload outfit photos.",
        "NSPhotoLibraryUsageDescription": "MirrorME needs photo library access to upload outfit photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.mirrorme.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "MirrorME needs access to your photos to upload outfits.",
          "cameraPermission": "MirrorME needs camera access to take outfit photos."
        }
      ]
    ],
    "scheme": "mirrorme",
    "experiments": {
      "typedRoutes": true
    }
  }
}
