PORT=3000
NODE_ENV=production

# PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/mirrorme_db"

# JWT  (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_64_char_random_secret_here
JWT_EXPIRES_IN=7d

# Cloudinary (get from cloudinary.com → Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=your_actual_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OpenAI (get from platform.openai.com → API Keys — must have billing enabled)
OPENAI_API_KEY=sk-your_openai_api_key

# Email — for password reset emails (use Gmail, Mailgun, SendGrid, etc.)
# Gmail: EMAIL_HOST=smtp.gmail.com  EMAIL_PORT=587  EMAIL_USER=you@gmail.com  EMAIL_PASSWORD=app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="MirrorME <noreply@mirrorme.app>"

# App URLs
APP_URL=https://mirrorme.app
ALLOWED_ORIGINS=https://mirrorme.app,exp://your-expo-url

# Version control (forces client updates when min version is raised)
APP_VERSION=1.0.0
MIN_CLIENT_VERSION=1.0.0
